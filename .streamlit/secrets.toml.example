# Copy this to .streamlit/secrets.toml for local use, OR
# paste each key into the Streamlit Community Cloud secrets dashboard.
# Never commit secrets.toml to git.

GROQ_API_KEY = "gsk_..."
GITHUB_TOKEN = "ghp_..."   # optional — only needed if you want to re-ingest
GITHUB_REPOS = ""          # leave blank to auto-discover, or set e.g. "myusername/my-project"
