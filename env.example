# Get your free Groq API key from: https://console.groq.com → API Keys
GROQ_API_KEY=gsk_...

# Get your GitHub token from: https://github.com/settings/tokens
# Only needs read:repo scope
GITHUB_TOKEN=ghp_...

# The repo(s) you want to index — comma-separated
# Example: myusername/my-project,myusername/another-repo
GITHUB_REPOS=owner/repo-name
